# Firebase Console > Proje ayarları > Web uygulaması yapılandırması.
# Bu değerler gizli değildir (tarayıcıya gömülür); güvenlik Firestore kurallarındadır.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Yerel geliştirmede emülatöre bağlanmak için 1 yapın (npm run emulators).
VITE_USE_EMULATORS=0
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8085
