rules_version = '2';

// IEEE İKÇÜ Hub — Firestore güvenlik kuralları
//
// Spark (ücretsiz) planda sunucu kodu (Cloud Functions) yoktur. Bu dosya Hub'ın
// TEK güvenilir katmanıdır: istemci ne gönderirse göndersin, yetki, onay sırası,
// evrak numarası ve doğrulama kaydı burada denetlenir. Bkz. docs/adr/0017.
//
// Yetki modeli (docs/adr/0019):
//   members/{uid}  : üyelik durumu (pending | active | suspended)
//   access/{uid}   : aktif görev atamalarından türetilen erişim özeti
//                    { superAdmin, perms{perm: bitiş}, roleKeys{"birim__rol": bitiş}, tokens[] }
//   Özeti yalnızca 'assignments.manage' izni olanlar yazar.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Yardımcılar ----------

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function docPath(coll, id) {
      return /databases/$(database)/documents/$(coll)/$(id);
    }

    function isActive() {
      return signedIn()
        && exists(docPath('members', me()))
        && get(docPath('members', me())).data.status == 'active';
    }

    function hasAccessDoc() {
      return exists(docPath('access', me()));
    }

    function acc() {
      return get(docPath('access', me())).data;
    }

    function isSuper() {
      return isActive() && hasAccessDoc() && acc().superAdmin == true;
    }

    function hasPerm(p) {
      return isActive() && hasAccessDoc()
        && (acc().superAdmin == true
            || (p in acc().perms && acc().perms[p] > request.time)
            // Yeni izin eklenmeden önce oluşturulmuş Genel Sekreter atamaları için geriye dönük uyum.
            || (p == 'secretary.ledger.manage'
                && 'branch__genel-sekreter' in acc().get('roleKeys', {})
                && acc().roleKeys['branch__genel-sekreter'] > request.time));
    }

    function hasRoleKey(k) {
      return hasAccessDoc() && k in acc().roleKeys && acc().roleKeys[k] > request.time;
    }

    function myTokens() {
      return hasAccessDoc() ? acc().tokens : ['uid:' + me()];
    }

    // Birim kapsamlı izin: erişim özetindeki "birim__izin" anahtarı (alt birimlere genişletilmiş).
    function hasUnitPerm(u, p) {
      return isActive() && hasAccessDoc()
        && (acc().superAdmin == true
            || ((u + '__' + p) in acc().get('unitPerms', {}) && acc().unitPerms[u + '__' + p] > request.time));
    }

    function unitManager(u) {
      return hasUnitPerm(u, 'unit.manage');
    }

    function meetingManager(u) {
      return unitManager(u)
        || hasUnitPerm(u, 'unit.meetings.manage')
        || hasPerm('work.manageAll')
        || hasPerm('secretary.ledger.manage');
    }

    function statuteManager() {
      return hasPerm('org.manage') || hasPerm('secretary.ledger.manage');
    }

    function validStatute(d) {
      return d.keys().hasOnly([
          'versionId', 'title', 'versionLabel', 'summary', 'fileName', 'mimeType',
          'size', 'sha256', 'chunkCount', 'publishedAt', 'publishedByName'
        ])
        && d.versionId is string && d.versionId.size() > 0
        && d.title is string && d.title.size() > 0
        && d.versionLabel is string && d.versionLabel.size() > 0
        && d.summary is string
        && d.fileName is string && d.fileName.size() > 0
        && d.mimeType in ['application/pdf', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document']
        && d.size is int && d.size > 0 && d.size <= 4 * 1024 * 1024
        && d.sha256 is string && d.sha256.size() == 64
        && d.chunkCount is int && d.chunkCount > 0 && d.chunkCount <= 8
        && d.publishedAt is timestamp
        && d.publishedByName is string && d.publishedByName.size() > 0;
    }

    function assetReader() {
      return hasPerm('inventory.manage')
        || hasPerm('finance.read')
        || hasPerm('finance.manage')
        || hasPerm('secretary.ledger.manage')
        || hasPerm('work.manageAll');
    }

    function assetManager() {
      return hasPerm('inventory.manage')
        || hasPerm('finance.manage')
        || hasPerm('secretary.ledger.manage');
    }

    function validAsset(d) {
      return d.keys().hasOnly([
          'code', 'name', 'category', 'description', 'serialNo', 'unitId', 'unitName', 'location',
          'status', 'condition', 'custodianUid', 'custodianName', 'purchaseDate', 'purchaseValue',
          'warrantyEndDate', 'notes', 'lastMovementId', 'createdBy', 'createdByName', 'createdAt',
          'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && d.code is string && d.code.size() > 0
        && d.name is string && d.name.size() > 0
        && d.category is string && d.description is string && d.serialNo is string
        && d.unitId is string && d.unitName is string && d.location is string
        && d.status in ['available', 'assigned', 'maintenance', 'lost', 'retired']
        && d.condition in ['good', 'needs_service', 'damaged']
        && (d.custodianUid == null || d.custodianUid is string)
        && d.custodianName is string
        && (d.purchaseDate == null || d.purchaseDate is string)
        && (d.purchaseValue == null || d.purchaseValue is number)
        && (d.warrantyEndDate == null || d.warrantyEndDate is string)
        && d.notes is string
        && d.lastMovementId is string && d.lastMovementId.size() > 0;
    }

    function matchingAssetMovement(id, d) {
      return existsAfter(/databases/$(database)/documents/assetMovements/$(d.lastMovementId))
        && getAfter(/databases/$(database)/documents/assetMovements/$(d.lastMovementId)).data.assetId == id
        && getAfter(/databases/$(database)/documents/assetMovements/$(d.lastMovementId)).data.assetCode == d.code
        && getAfter(/databases/$(database)/documents/assetMovements/$(d.lastMovementId)).data.assetName == d.name
        && getAfter(/databases/$(database)/documents/assetMovements/$(d.lastMovementId)).data.at == request.time;
    }

    function isMember(u) {
      return hasAccessDoc() && u in acc().get('memberOf', {}) && acc().memberOf[u] > request.time;
    }

    function volunteerRole() {
      return get(docPath('settings', 'org')).data.get('volunteerRoleId', 'gonullu');
    }

    // İmza gibi kritik işlemlerde son 15 dakika içinde giriş yapılmış olmalı.
    function recentAuth() {
      return request.time.toMillis() - request.auth.token.auth_time * 1000 < 15 * 60 * 1000;
    }

    function onlyKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- Kurulum (ilk yönetici) ----------
    // Sistemde hiç kurulum kaydı yoksa, giriş yapan ilk kişi kendini kurucu yönetici yapabilir.
    // Kurulum kaydı, üye kaydı ve erişim özeti aynı batch içinde yazılır.

    function bootstrapOwner() {
      return signedIn()
        && request.auth.token.email == 'techopsieee@gmail.com';
    }

    function bootstrapping() {
      return bootstrapOwner()
        && !exists(docPath('system', 'bootstrap'))
        && existsAfter(docPath('system', 'bootstrap'))
        && getAfter(docPath('system', 'bootstrap')).data.uid == me();
    }

    match /system/bootstrap {
      allow read: if signedIn();
      allow create: if bootstrapOwner()
        && request.resource.data.uid == me()
        && request.resource.data.at == request.time
        && existsAfter(docPath('members', me()))
        && existsAfter(docPath('access', me()));
      allow update, delete: if false;
    }

    // ---------- Kurum ayarları ----------

    match /settings/public {
      // Giriş ekranındaki kurum adı ve logo herkese açıktır.
      allow read: if true;
      // Politika işaretçileri yalnız aynı türde yayımlanmış bir sürümü gösterebilir.
      allow write: if hasPerm('org.manage')
        && policyPointerOk('recruitmentPrivacyNoticeId', 'recruitment')
        && policyPointerOk('memberPrivacyNoticeId', 'members')
        && policyPointerOk('cookiePolicyId', 'cookies')
        && policyPointerOk('termsId', 'terms');
    }

    // ---------- Politika metinleri (KVKK, çerez, kullanım koşulları): herkese açık, değiştirilemez sürümler ----------

    function policyPointerOk(field, kind) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
            && existsAfter(docPath('privacyNotices', request.resource.data[field]))
            && getAfter(docPath('privacyNotices', request.resource.data[field])).data.kind == kind);
    }

    match /privacyNotices/{id} {
      allow read: if true;
      allow create: if hasPerm('org.manage')
        && request.resource.data.keys().hasOnly(['kind', 'title', 'versionLabel', 'body', 'publishedAt'])
        && request.resource.data.kind in ['recruitment', 'members', 'cookies', 'terms']
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.versionLabel is string && request.resource.data.versionLabel.size() > 0 && request.resource.data.versionLabel.size() <= 60
        && request.resource.data.body is string && request.resource.data.body.size() >= 200 && request.resource.data.body.size() <= 30000
        && request.resource.data.publishedAt == request.time;
      allow update, delete: if false;
    }

    match /settings/{docId} {
      allow read: if isActive();
      // settings/public kendi eşleşmesinde doğrulanır; kurallar VEYA ile birleştiği için burada dışlanır.
      allow write: if docId != 'public' && hasPerm('org.manage');
    }

    // ---------- Herkese açık tüzük ve değiştirilemez sürüm arşivi ----------

    match /statutes/current {
      allow read: if true;
      allow create, update: if statuteManager()
        && validStatute(request.resource.data)
        && request.resource.data == getAfter(/databases/$(database)/documents/statuteVersions/$(request.resource.data.versionId)).data;
      allow delete: if false;
    }

    match /statuteVersions/{versionId} {
      allow read: if true;
      allow create: if statuteManager()
        && request.resource.data.versionId == versionId
        && request.resource.data.publishedAt == request.time
        && validStatute(request.resource.data);
      allow update, delete: if false;

      match /chunks/{chunkId} {
        allow read: if true;
        allow create: if statuteManager()
          && request.resource.data.keys().hasOnly(['index', 'data'])
          && request.resource.data.index is int && request.resource.data.index >= 0
          && request.resource.data.data is string && request.resource.data.data.size() > 0
          && request.resource.data.data.size() <= 700000
          && existsAfter(/databases/$(database)/documents/statuteVersions/$(versionId))
          && getAfter(/databases/$(database)/documents/statuteVersions/$(versionId)).data.publishedAt == request.time;
        allow update, delete: if false;
      }
    }

    // ---------- Üyeler ----------

    match /members/{uid} {
      allow read: if me() == uid || isActive();

      allow create: if signedIn() && me() == uid
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == request.time
        && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'active' && bootstrapping()));

      // Kişi kendi iletişim bilgilerini günceller; durum yalnızca üye yöneticisinde.
      allow update: if (me() == uid && isActive()
                         && onlyKeys(['displayName', 'phone', 'department', 'studentNo', 'photoURL', 'updatedAt']))
                    || (me() == uid && resource.data.status == 'pending'
                         && onlyKeys(['displayName', 'phone', 'department', 'studentNo', 'photoURL', 'updatedAt']))
                    // Üye yöneticisi kendi üyelik durumunu değiştiremez (kendini yanlışlıkla pasifleştirmeyi önler).
                    || (hasPerm('members.manage')
                        && (me() != uid || request.resource.data.status == resource.data.status));

      allow delete: if hasPerm('members.manage') && me() != uid;
    }

    // ---------- Erişim özeti ----------

    match /access/{uid} {
      allow read: if me() == uid || hasPerm('assignments.manage');

      allow create: if (bootstrapping() && me() == uid && request.resource.data.superAdmin == true)
                    || (hasPerm('assignments.manage')
                        && request.resource.data.superAdmin == false)
                    || isSuper()
                    || volunteerDelegationCreate();

      // superAdmin bayrağını yalnızca kurucu yönetici değiştirebilir.
      allow update: if isSuper()
                    || (hasPerm('assignments.manage')
                        && request.resource.data.superAdmin == resource.data.superAdmin)
                    || volunteerDelegationUpdate();

      // Birim yöneticisi (unit.manage), kendi biriminde yalnızca gönüllü rolünü ekleyip çıkarabilir.
      // Değişiklik tek bir rol anahtarı, tek bir birim üyeliği ve tek bir görünürlük anahtarıyla sınırlıdır.
      function delegationBasics() {
        let ld = request.resource.data.lastDelegation;
        return ld.by == me()
          && ld.roleId == volunteerRole()
          && unitManager(ld.unitId);
      }

      function volunteerDelegationUpdate() {
        let ld = request.resource.data.lastDelegation;
        let key = ld.unitId + '__' + ld.roleId;
        let d = request.resource.data;
        return delegationBasics()
          && d.diff(resource.data).affectedKeys().hasOnly(['roleKeys', 'tokens', 'memberOf', 'lastDelegation', 'updatedAt'])
          && d.get('roleKeys', {}).diff(resource.data.get('roleKeys', {})).affectedKeys().hasOnly([key])
          && d.get('memberOf', {}).diff(resource.data.get('memberOf', {})).affectedKeys().hasOnly([ld.unitId])
          && d.get('tokens', []).toSet().difference(resource.data.get('tokens', []).toSet()).hasOnly(['role:' + key])
          && resource.data.get('tokens', []).toSet().difference(d.get('tokens', []).toSet()).hasOnly(['role:' + key]);
      }

      function volunteerDelegationCreate() {
        let ld = request.resource.data.lastDelegation;
        let key = ld.unitId + '__' + ld.roleId;
        let d = request.resource.data;
        return delegationBasics()
          && d.keys().hasOnly(['superAdmin', 'perms', 'unitPerms', 'roleKeys', 'tokens', 'memberOf', 'lastDelegation', 'updatedAt'])
          && d.superAdmin == false && d.perms == {} && d.unitPerms == {}
          && d.roleKeys.keys().hasOnly([key])
          && d.memberOf.keys().hasOnly([ld.unitId])
          && d.tokens.toSet().hasOnly(['uid:' + uid, 'role:' + key]);
      }

      allow delete: if isSuper();
    }

    // ---------- Organizasyon: birimler, roller, dönemler ----------

    match /units/{id} {
      allow read: if isActive();
      allow write: if hasPerm('org.manage');
    }

    match /roles/{id} {
      allow read: if isActive();
      allow write: if hasPerm('org.manage');
    }

    match /terms/{id} {
      allow read: if isActive();
      allow write: if hasPerm('org.manage');
    }

    match /assignments/{id} {
      allow read: if isActive();
      allow create: if hasPerm('assignments.manage')
                    || (hasPerm('elections.manage') && request.resource.data.source == 'election')
                    || (request.resource.data.source == 'volunteer'
                        && request.resource.data.status == 'active'
                        && request.resource.data.roleId == volunteerRole()
                        && unitManager(request.resource.data.unitId));
      allow update: if hasPerm('assignments.manage')
                    || (hasPerm('elections.manage') && request.resource.data.source == 'election')
                    || (resource.data.roleId == volunteerRole()
                        && unitManager(resource.data.unitId)
                        && request.resource.data.status == 'ended'
                        && onlyKeys(['status', 'endedAt', 'endedBy']));
      allow delete: if hasPerm('assignments.manage');
    }

    match /elections/{id} {
      allow read: if isActive();
      allow create: if hasPerm('elections.manage')
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status == 'draft'
        && request.resource.data.positions is list;
      allow update: if hasPerm('elections.manage')
        && resource.data.status != 'applied'
        && resource.data.status != 'cancelled'
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.positions is list
        && (
             (request.resource.data.status == resource.data.status
               && resource.data.status in ['draft', 'nominations', 'voting'])
          || (resource.data.status == 'draft' && request.resource.data.status in ['nominations', 'cancelled'])
          || (resource.data.status == 'nominations' && request.resource.data.status in ['draft', 'voting', 'cancelled'])
          || (resource.data.status == 'voting' && request.resource.data.status in ['completed', 'cancelled'])
          || (resource.data.status == 'completed' && request.resource.data.status == 'applied')
        );
      allow delete: if hasPerm('elections.manage') && resource.data.status in ['draft', 'cancelled'];
    }

    // ---------- Denetim kaydı (yalnızca ekleme) ----------

    match /auditLog/{id} {
      allow read: if hasPerm('audit.read');
      allow create: if isActive()
        && request.resource.data.actorUid == me()
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ---------- Dilekçe şablonları ----------

    match /petitionTemplates/{tid} {
      allow read: if isActive();
      allow create, delete: if hasPerm('templates.manage');
      // Yürürlükteki sürüm yalnızca yayımlanmış (var olan) bir sürüme ayarlanabilir.
      allow update: if hasPerm('templates.manage')
        && (request.resource.data.currentVersion == 0
            || existsAfter(/databases/$(database)/documents/petitionTemplates/$(tid)/versions/$(string(request.resource.data.currentVersion))));

      match /draftChunks/{c} {
        allow read: if isActive();
        allow write: if hasPerm('templates.manage');
      }

      // Yayımlanmış sürüm değiştirilemez ve silinemez. Süreçteki dilekçeler sürüme sabitlenir.
      match /versions/{v} {
        allow read: if isActive();
        allow create: if hasPerm('templates.manage')
          && request.resource.data.version == int(v)
          && request.resource.data.publishedBy == me()
          && request.resource.data.publishedAt == request.time;
        allow update, delete: if false;

        match /chunks/{c} {
          allow read: if isActive();
          allow create: if hasPerm('templates.manage');
          allow update, delete: if false;
        }
      }
    }

    // ---------- Evrak sayaçları ----------
    // Sayaç yalnızca bir dilekçenin ilk gönderimiyle aynı batch içinde, birer birer artar.
    // Böylece evrak numaraları boşluksuz ve tekrarsız ilerler.

    match /counters/{cid} {
      function pairedSubmit() {
        let pid = request.resource.data.lastPetitionId;
        let before = get(docPath('petitions', pid)).data;
        let after = getAfter(docPath('petitions', pid)).data;
        return before.status == 'draft'
          && after.status == 'pending'
          && after.counterId == cid
          && after.documentSeq == request.resource.data.value;
      }

      allow read: if isActive();
      allow create: if isActive() && request.resource.data.value == 1 && pairedSubmit();
      allow update: if isActive() && request.resource.data.value == resource.data.value + 1 && pairedSubmit();
      allow delete: if false;
    }

    // ---------- Dilekçeler ----------

    match /petitions/{pid} {
      function p() {
        return resource.data;
      }

      function np() {
        return request.resource.data;
      }

      function tmpl() {
        return get(docPath('petitionTemplates', np().templateId)).data;
      }

      function tmplVersion() {
        return get(/databases/$(database)/documents/petitionTemplates/$(np().templateId)/versions/$(string(np().templateVersion))).data;
      }

      function canRead() {
        return isActive()
          && (p().ownerUid == me()
              || hasPerm('petitions.readAll')
              || p().visibleTo.hasAny(myTokens()));
      }

      function unitAllowed() {
        let t = tmpl();
        return (t.scope == 'branch' && np().unitId == 'branch')
          || (t.scope == 'unit' && np().unitId != 'branch'
              && (t.unitIds.size() == 0 || np().unitId in t.unitIds));
      }

      // Bir adımın onay biriminin çözümü: dilekçenin birimi, kol geneli veya sabit birim.
      function stepUnit(step) {
        return step.unitMode == 'petition' ? p().unitId
          : (step.unitMode == 'branch' ? 'branch' : step.unitId);
      }

      function requiredApprovals(step) {
        return step.get('approvalMode', 'any') == 'all' ? step.roleIds.size()
          : (step.get('approvalMode', 'any') == 'quorum' ? step.get('requiredApprovals', 1) : 1);
      }

      // --- Taslak ---

      function draftKeys() {
        return ['templateId', 'templateVersion', 'templateName', 'unitId', 'unitName', 'ownerUid',
                'ownerName', 'title', 'data', 'status', 'visibleTo', 'createdAt', 'updatedAt'];
      }

      function validDraftCreate() {
        return np().keys().hasOnly(draftKeys())
          && np().ownerUid == me()
          && np().status == 'draft'
          && np().data is map
          && np().visibleTo == ['uid:' + me()]
          && np().createdAt == request.time;
      }

      function editDraft() {
        return p().status == 'draft' && p().ownerUid == me()
          && np().status == 'draft'
          && np().data is map
          && onlyKeys(['title', 'data', 'unitId', 'unitName', 'templateVersion', 'templateName', 'updatedAt']);
      }

      // --- Gönderim (taslak → onayda) ---
      // Onay zinciri, şablon sürümündeki zincirle birebir aynı olmalıdır.

      function commonSubmit() {
        return p().ownerUid == me()
          && np().status == 'pending'
          && np().currentStep == 0
          && np().submittedAt == request.time
          && np().updatedAt == request.time
          && np().data is map
          && np().steps == tmplVersion().steps
          && np().steps.size() > 0
          && unitAllowed()
          && ('uid:' + me()) in np().visibleTo
          && np().visibleTo.size() <= 40;
      }

      function firstSubmit() {
        let counterPath = docPath('counters', np().counterId);
        let t = tmpl();
        return p().status == 'draft'
          && t.active == true
          && np().templateVersion == t.currentVersion
          && np().counterId == t.series + '_' + string(request.time.year())
          && np().documentSeq == (exists(counterPath) ? get(counterPath).data.value + 1 : 1)
          && getAfter(counterPath).data.value == np().documentSeq
          && getAfter(counterPath).data.lastPetitionId == pid
          && np().documentNo is string && np().documentNo.size() > 0
          && np().verificationCode is string && np().verificationCode.size() == 12
          && existsAfter(docPath('petitionVerifications', np().verificationCode))
          && np().revision == 1
          && np().approvals == []
          && np().approvalData == {}
          && np().stepApprovalRoleIds == []
          && np().notes == []
          && commonSubmit()
          && onlyKeys(['status', 'steps', 'currentStep', 'counterId', 'documentSeq', 'documentNo',
                       'verificationCode', 'revision', 'approvals', 'approvalData', 'stepApprovalRoleIds', 'notes', 'submittedAt', 'updatedAt',
                       'visibleTo', 'data', 'title', 'unitId', 'unitName', 'templateVersion', 'templateName']);
      }

      // İade edilen dilekçe düzeltilip yeniden gönderilir: aynı evrak numarası, yeni revizyon,
      // zincir baştan başlar. Eski onaylar geçmiş olarak kalır.
      function resubmit() {
        return p().status == 'returned'
          && np().revision == p().revision + 1
          && np().templateVersion == p().templateVersion
          && np().unitId == p().unitId
          && np().approvalData == {}
          && np().stepApprovalRoleIds == []
          && commonSubmit()
          && onlyKeys(['status', 'currentStep', 'approvalData', 'stepApprovalRoleIds', 'revision', 'submittedAt', 'updatedAt', 'data', 'title', 'visibleTo']);
      }

      // --- Onay / ret / iade ---

      function validApprovalData(step) {
        let before = p().get('approvalData', {});
        let after = np().get('approvalData', {});
        let changed = after.diff(before).affectedKeys();
        return after is map
          && changed.hasOnly(step.get('responseFieldKeys', []))
          && !changed.hasAny(before.keys());
      }

      function decide() {
        let n = p().approvals.size();
        let a = np().approvals[n];
        let step = p().steps[p().currentStep];
        let unitKey = stepUnit(step);
        let isLast = p().currentStep == p().steps.size() - 1;
        let oldRoles = p().get('stepApprovalRoleIds', []);
        let newRoles = np().get('stepApprovalRoleIds', []);
        let completesStep = oldRoles.size() + 1 >= requiredApprovals(step);
        let appendsRole = !(a.roleId in oldRoles)
          && newRoles.size() == oldRoles.size() + 1
          && (oldRoles.size() == 0 || newRoles[0:oldRoles.size()] == oldRoles)
          && newRoles[oldRoles.size()] == a.roleId;
        return p().status == 'pending'
          && p().ownerUid != me()
          && recentAuth()
          && np().approvals.size() == n + 1
          && (n == 0 || np().approvals[0:n] == p().approvals)
          && a.keys().hasOnly(['step', 'stepName', 'revision', 'uid', 'name', 'roleId', 'roleName',
                               'unitId', 'unitName', 'decision', 'at'])
          && a.uid == me()
          && a.at is timestamp
          && a.at > request.time - duration.value(10, 'm')
          && a.at < request.time + duration.value(10, 'm')
          && a.step == p().currentStep
          && a.revision == p().revision
          && a.unitId == unitKey
          && a.roleId in step.roleIds
          && !(a.roleId in oldRoles)
          && hasRoleKey(unitKey + '__' + a.roleId)
          && validApprovalData(step)
          && np().updatedAt == request.time
          && (np().notes.size() == p().notes.size()
              || (np().notes.size() == p().notes.size() + 1
                  && (p().notes.size() == 0 || np().notes[0:p().notes.size()] == p().notes)
                  && np().notes[p().notes.size()].approvalIndex == n))
          && (
               (a.decision == 'approve' && !completesStep
                  && appendsRole
                  && np().status == 'pending' && np().currentStep == p().currentStep
                  && onlyKeys(['approvals', 'approvalData', 'notes', 'status', 'stepApprovalRoleIds', 'updatedAt']))
            || (a.decision == 'approve' && completesStep && !isLast
                  && np().stepApprovalRoleIds == []
                  && np().status == 'pending' && np().currentStep == p().currentStep + 1
                  && onlyKeys(['approvals', 'approvalData', 'notes', 'status', 'currentStep', 'stepApprovalRoleIds', 'updatedAt']))
            || (a.decision == 'approve' && completesStep && isLast
                  && appendsRole
                  && np().status == 'approved' && np().completedAt == request.time
                  && onlyKeys(['approvals', 'approvalData', 'notes', 'status', 'stepApprovalRoleIds', 'completedAt', 'updatedAt']))
            || (a.decision == 'reject'
                  && np().status == 'rejected' && np().completedAt == request.time
                  && np().notes.size() == p().notes.size() + 1
                  && onlyKeys(['approvals', 'approvalData', 'notes', 'status', 'completedAt', 'updatedAt']))
            || (a.decision == 'return'
                  && np().status == 'returned'
                  && np().notes.size() == p().notes.size() + 1
                  && onlyKeys(['approvals', 'approvalData', 'notes', 'status', 'updatedAt']))
          );
      }

      // --- Geri çekme ---

      function withdraw() {
        return p().ownerUid == me()
          && p().status in ['pending', 'returned']
          && np().status == 'withdrawn'
          && np().completedAt == request.time
          && np().updatedAt == request.time
          && onlyKeys(['status', 'completedAt', 'updatedAt']);
      }

      allow get, list: if canRead();
      allow create: if isActive() && validDraftCreate();
      // Dallar mevcut/yeni duruma göre ayrılır; böylece her istekte yalnızca bir dal değerlendirilir
      // (Firestore kurallarında istek başına 1000 ifade sınırı vardır).
      allow update: if isActive() && (
           (p().status == 'draft' && np().status == 'draft' && editDraft())
        || (p().status == 'draft' && np().status == 'pending' && firstSubmit())
        || (p().status == 'returned' && np().status == 'pending' && resubmit())
        || (p().status == 'pending' && np().status != 'withdrawn' && decide())
        || (np().status == 'withdrawn' && withdraw())
      );
      allow delete: if isActive() && p().ownerUid == me() && p().status == 'draft';
    }

    // ---------- Herkese açık doğrulama kaydı ----------
    // İçerik yoktur; yalnızca evrak no, durum ve onay özeti. Kayıt, dilekçenin kendisiyle
    // aynı batch içinde yazılmak zorundadır ve alanları dilekçeyle birebir aynı olmalıdır.

    match /petitionVerifications/{code} {
      function petitionAfter() {
        return getAfter(docPath('petitions', request.resource.data.petitionId)).data;
      }

      function mirrors() {
        let pa = petitionAfter();
        return pa.verificationCode == code
          && pa.updatedAt == request.time
          && request.resource.data.status == pa.status
          && request.resource.data.approvals == pa.approvals
          && request.resource.data.documentNo == pa.documentNo
          && request.resource.data.templateName == pa.templateName
          && request.resource.data.revision == pa.revision
          && request.resource.data.updatedAt == request.time;
      }

      allow get: if true;
      allow list: if false;
      allow create: if isActive()
        && get(docPath('petitions', request.resource.data.petitionId)).data.status == 'draft'
        && get(docPath('petitions', request.resource.data.petitionId)).data.ownerUid == me()
        && mirrors();
      allow update: if isActive()
        && request.resource.data.petitionId == resource.data.petitionId
        && request.resource.data.ownerMasked == resource.data.ownerMasked
        && request.resource.data.submittedAt == resource.data.submittedAt
        && mirrors();
      allow delete: if false;
    }
  
    // ================= Operasyon modülleri =================

    // ---------- Gönüllü başvuruları (WP-04) ----------

    match /volunteerApplications/{id} {
      allow read: if isActive()
        && (resource.data.uid == me() || unitManager(resource.data.unitId) || hasPerm('members.manage'));
      allow create: if isActive()
        && request.resource.data.uid == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isActive()
        && (unitManager(resource.data.unitId) || hasPerm('assignments.manage'))
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.decidedBy == me()
        && onlyKeys(['status', 'decidedBy', 'decidedByName', 'decidedAt', 'decisionNote']);
      allow delete: if isActive() && resource.data.uid == me() && resource.data.status == 'pending';
    }

    // ---------- Tarihli komite / YK başvuru ilanları ----------

    function recruitmentManager(u) {
      return unitManager(u) || hasPerm('assignments.manage');
    }

    function validRecruitmentCall(d) {
      return d.keys().hasOnly([
          'unitId', 'unitName', 'title', 'roleTitle', 'summary', 'description',
          'expectations', 'capacity', 'status', 'opensAt', 'closesAt', 'questions',
          'createdAt', 'updatedAt'
        ])
        && d.unitId is string && d.unitId.size() > 0
        && d.unitName is string && d.unitName.size() > 0
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.roleTitle is string && d.roleTitle.size() > 0 && d.roleTitle.size() <= 120
        && d.summary is string && d.summary.size() > 0 && d.summary.size() <= 500
        && d.description is string && d.description.size() <= 5000
        && d.expectations is string && d.expectations.size() <= 3000
        && (d.capacity == null || (d.capacity is int && d.capacity > 0 && d.capacity <= 500))
        && d.status in ['draft', 'open', 'closed', 'archived']
        && d.opensAt is timestamp && d.closesAt is timestamp && d.opensAt < d.closesAt
        && d.questions is list && d.questions.size() <= 10
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    // İlanı açan kişinin kimliği herkese açık ilan belgesinde tutulmaz; yalnız yöneticilerin
    // okuyabildiği internal/meta alt belgesinde, ilanla aynı yazımda saklanır.
    function recruitmentCallMetaPath(id) {
      return /databases/$(database)/documents/recruitmentCalls/$(id)/internal/meta;
    }

    match /recruitmentCalls/{id} {
      // Açık ilan içeriği aday vitrininin bilinçli olarak herkese açık bölümüdür.
      allow read: if resource.data.status == 'open' || recruitmentManager(resource.data.unitId);
      allow create: if recruitmentManager(request.resource.data.unitId)
        && validRecruitmentCall(request.resource.data)
        && request.resource.data.status == 'draft'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(recruitmentCallMetaPath(id)).data.createdBy == me();
      // Eski kayıtlardaki createdBy/createdByName alanları ilk güncellemede silinmek zorundadır
      // (validRecruitmentCall bu alanlara izin vermez).
      allow update: if recruitmentManager(resource.data.unitId)
        && recruitmentManager(request.resource.data.unitId)
        && request.resource.data.unitId == resource.data.unitId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validRecruitmentCall(request.resource.data);
      allow delete: if false;
    }

    match /recruitmentCalls/{id}/internal/{docId} {
      allow read: if signedIn() && recruitmentManager(get(docPath('recruitmentCalls', id)).data.unitId);
      allow create: if signedIn()
        && docId == 'meta'
        && !exists(docPath('recruitmentCalls', id))
        && recruitmentManager(getAfter(docPath('recruitmentCalls', id)).data.unitId)
        && request.resource.data.keys().hasOnly(['createdBy', 'createdByName', 'createdAt'])
        && request.resource.data.createdBy == me()
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0 && request.resource.data.createdByName.size() <= 150
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Değerlendiren yöneticinin kimliği adayın okuyabildiği başvuru belgesinde tutulmaz;
    // internal/review alt belgesinde, karar güncellemesiyle aynı yazımda saklanır.
    function recruitmentReviewPath(id) {
      return /databases/$(database)/documents/recruitmentApplications/$(id)/internal/review;
    }

    function recruitmentCallForApplication() {
      return get(docPath('recruitmentCalls', request.resource.data.callId)).data;
    }

    function validRecruitmentApplication(d) {
      return d.keys().hasOnly([
          'callId', 'callTitle', 'unitId', 'unitName', 'uid', 'name', 'email',
          'phone', 'department', 'studentNo', 'ieeeMemberNo', 'motivation',
          'availability', 'answers', 'privacyConsent', 'privacyNoticeId', 'status', 'submittedAt', 'updatedAt'
        ])
        && d.callId is string && d.callId.size() > 0
        && d.callTitle is string && d.callTitle.size() > 0
        && d.unitId is string && d.unitId.size() > 0
        && d.unitName is string && d.unitName.size() > 0
        && d.uid == me()
        && d.name is string && d.name.size() > 0 && d.name.size() <= 150
        && d.email is string && d.email.size() <= 254
        && d.phone is string && d.phone.size() <= 40
        && d.department is string && d.department.size() > 0 && d.department.size() <= 160
        && d.studentNo is string && d.studentNo.size() <= 40
        && d.ieeeMemberNo is string && d.ieeeMemberNo.size() <= 40
        && d.motivation is string && d.motivation.size() >= 40 && d.motivation.size() <= 5000
        && d.availability is string && d.availability.size() <= 500
        && d.answers is map
        && d.privacyConsent == true
        // Aday, başvuru anında yayımlı olan aydınlatma metni sürümünü okuduğunu beyan eder;
        // yayımlı metin yoksa başvuru alınmaz.
        && d.privacyNoticeId is string
        && d.privacyNoticeId == get(docPath('settings', 'public')).data.recruitmentPrivacyNoticeId
        && d.status == 'pending'
        && d.submittedAt == request.time && d.updatedAt == request.time;
    }

    match /recruitmentApplications/{id} {
      allow read: if signedIn()
        && (resource.data.uid == me() || recruitmentManager(resource.data.unitId));
      allow create: if signedIn()
        && id == request.resource.data.callId + '__' + me()
        && validRecruitmentApplication(request.resource.data)
        && recruitmentCallForApplication().status == 'open'
        && recruitmentCallForApplication().unitId == request.resource.data.unitId
        && recruitmentCallForApplication().title == request.resource.data.callTitle
        && recruitmentCallForApplication().opensAt <= request.time
        && recruitmentCallForApplication().closesAt >= request.time;
      allow update: if signedIn() && (
        (resource.data.uid == me()
          && resource.data.status in ['pending', 'reviewing', 'waitlisted']
          && request.resource.data.status == 'withdrawn'
          && request.resource.data.updatedAt == request.time
          && onlyKeys(['status', 'updatedAt']))
        || (recruitmentManager(resource.data.unitId)
          && resource.data.status in ['pending', 'reviewing', 'waitlisted']
          && request.resource.data.status in ['reviewing', 'waitlisted', 'accepted', 'rejected']
          && !('reviewedBy' in request.resource.data)
          && !('reviewedByName' in request.resource.data)
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.updatedAt == request.time
          && (!('decisionNote' in request.resource.data)
              || (request.resource.data.decisionNote is string && request.resource.data.decisionNote.size() <= 2000))
          && onlyKeys(['status', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'decisionNote', 'updatedAt'])
          && getAfter(recruitmentReviewPath(id)).data.reviewedBy == me()
          && getAfter(recruitmentReviewPath(id)).data.reviewedAt == request.time)
      );
      allow delete: if false;
    }

    match /recruitmentApplications/{id}/internal/{docId} {
      allow read: if signedIn() && recruitmentManager(get(docPath('recruitmentApplications', id)).data.unitId);
      allow create, update: if signedIn()
        && docId == 'review'
        && recruitmentManager(get(docPath('recruitmentApplications', id)).data.unitId)
        && request.resource.data.keys().hasOnly(['reviewedBy', 'reviewedByName', 'reviewedAt', 'status'])
        && request.resource.data.reviewedBy == me()
        && request.resource.data.reviewedByName is string
        && request.resource.data.reviewedByName.size() > 0 && request.resource.data.reviewedByName.size() <= 150
        && request.resource.data.reviewedAt == request.time
        && getAfter(docPath('recruitmentApplications', id)).data.status == request.resource.data.status
        && getAfter(docPath('recruitmentApplications', id)).data.reviewedAt == request.time;
      allow delete: if false;
    }

    // ---------- Görevler ve projeler (WP-05) ----------

    function canManageWork(u) {
      return hasPerm('work.manageAll') || unitManager(u) || hasUnitPerm(u, 'unit.tasks.manage');
    }

    function canReadTask(d) {
      return isActive()
        && (d.assigneeUid == me()
            || me() in d.supporterUids
            || isMember(d.unitId)
            || hasPerm('work.manageAll')
            || hasPerm('reports.read'));
    }

    function validTask(d) {
      return d.title is string && d.title.size() > 0
        && d.assigneeUid is string && d.assigneeUid.size() > 0
        && d.supporterUids is list
        && d.status in ['todo', 'in_progress', 'blocked', 'done', 'cancelled']
        && d.priority in ['low', 'normal', 'high', 'urgent']
        && d.doneCriteria is string;
    }

    match /tasks/{id} {
      allow read: if canReadTask(resource.data);
      allow create: if isActive()
        && canManageWork(request.resource.data.unitId)
        && request.resource.data.createdBy == me()
        && validTask(request.resource.data);
      allow update: if isActive() && (
           (canManageWork(resource.data.unitId) && canManageWork(request.resource.data.unitId)
             && validTask(request.resource.data))
        || ((resource.data.assigneeUid == me() || me() in resource.data.supporterUids)
             && request.resource.data.status in ['todo', 'in_progress', 'blocked', 'done']
             && onlyKeys(['status', 'statusNote', 'fileLink', 'updatedAt', 'completedAt']))
      );
      allow delete: if isActive() && canManageWork(resource.data.unitId);

      match /comments/{cid} {
        allow read: if canReadTask(get(/databases/$(database)/documents/tasks/$(id)).data);
        allow create: if canReadTask(get(/databases/$(database)/documents/tasks/$(id)).data)
          && request.resource.data.byUid == me()
          && request.resource.data.at == request.time;
        allow delete: if isActive() && resource.data.byUid == me();
      }
    }

    match /taskCounters/{unitId} {
      allow read: if isActive();
      allow create: if canManageWork(unitId) && request.resource.data.value == 1;
      allow update: if canManageWork(unitId) && request.resource.data.value == resource.data.value + 1;
    }

    match /projects/{id} {
      allow read: if isActive()
        && (isMember(resource.data.unitId) || resource.data.ownerUid == me()
            || hasPerm('work.manageAll') || hasPerm('reports.read'));
      allow create: if isActive()
        && (unitManager(request.resource.data.unitId) || hasPerm('work.manageAll'));
      allow update: if isActive()
        && ((unitManager(resource.data.unitId) && unitManager(request.resource.data.unitId))
            || hasPerm('work.manageAll')
            || (resource.data.ownerUid == me() && request.resource.data.ownerUid == me()
                && request.resource.data.unitId == resource.data.unitId));
      allow delete: if isActive() && (unitManager(resource.data.unitId) || hasPerm('work.manageAll'));
    }

    // ---------- Dönemler arası etkinlik kısıtlamaları ----------

    match /eventRestrictions/{id} {
      function r() { return resource.data; }
      function nr() { return request.resource.data; }

      // Kimlik ve gerekçe yalnız üye yöneticilerince görülür; kayıtlar silinmez.
      allow read: if hasPerm('members.manage');
      allow create: if hasPerm('members.manage')
        && nr().keys().hasOnly(['personName', 'email', 'emailHash', 'level', 'reason', 'sourceEventId', 'sourceEventName', 'evidenceLink', 'endsOn', 'reviewOn', 'active', 'createdBy', 'createdByName', 'createdAt'])
        && nr().personName is string && nr().personName.size() > 0 && nr().personName.size() <= 160
        && nr().email is string && nr().email.size() > 3 && nr().email.size() <= 254
        && nr().emailHash is string && nr().emailHash.size() == 32
        && nr().level in ['watch', 'blocked']
        && nr().reason is string && nr().reason.size() >= 10 && nr().reason.size() <= 5000
        && (nr().sourceEventId == null || nr().sourceEventId is string)
        && nr().sourceEventName is string && nr().sourceEventName.size() <= 200
        && nr().evidenceLink is string && nr().evidenceLink.size() <= 1000
        && (nr().endsOn == null || nr().endsOn is string)
        && (nr().reviewOn == null || nr().reviewOn is string)
        && nr().active == true
        && nr().createdBy == me() && nr().createdByName is string
        && nr().createdAt == request.time;
      allow update: if hasPerm('members.manage')
        && r().active == true && nr().active == false
        && nr().liftedBy == me() && nr().liftedByName is string
        && nr().liftedAt == request.time
        && nr().liftReason is string && nr().liftReason.size() >= 5
        && onlyKeys(['active', 'liftedBy', 'liftedByName', 'liftedAt', 'liftReason']);
      allow delete: if false;
    }

    match /eventRestrictionIndex/{emailHash} {
      function idx() { return request.resource.data; }
      function indexedRestriction() { return getAfter(docPath('eventRestrictions', idx().restrictionId)).data; }
      function validIndex() {
        let restriction = indexedRestriction();
        return emailHash.size() == 32
          && idx().keys().hasOnly(['restrictionId', 'level', 'expiresAt', 'updatedAt'])
          && idx().restrictionId is string && idx().restrictionId.size() > 0
          && idx().level in ['watch', 'blocked']
          && idx().expiresAt is timestamp && idx().updatedAt == request.time
          && restriction.active == true
          && restriction.emailHash == emailHash
          && restriction.level == idx().level;
      }

      // Etkinlik sorumluları yalnız bildikleri e-posta özetini tekil sorgulayabilir; listeleyemez.
      allow get: if isActive();
      allow list: if hasPerm('members.manage');
      allow create, update: if hasPerm('members.manage') && validIndex();
      allow delete: if hasPerm('members.manage');
    }

    // ---------- Etkinlikler (WP-06) ----------

    function eventManager(u) {
      return hasPerm('events.manageAll') || unitManager(u);
    }

    function isEventOwner(d) {
      return me() in d.ownerUids;
    }

    function approvedPetitionFor(pid, unitId) {
      let p = get(docPath('petitions', pid)).data;
      return p.status == 'approved' && p.unitId == unitId;
    }

    match /events/{id} {
      function e() { return resource.data; }
      function ne() { return request.resource.data; }

      allow read: if isActive();

      allow create: if isActive()
        && (hasUnitPerm(ne().unitId, 'unit.events.propose') || eventManager(ne().unitId))
        && ne().status == 'proposed'
        && ne().createdBy == me()
        && ne().get('reportApproved', false) == false;

      allow update: if isActive() && (
           // YK kararı
           (e().status == 'proposed' && ne().status in ['approved', 'rejected']
             && hasPerm('events.approve')
             && onlyKeys(['status', 'decisionNote', 'decidedBy', 'decidedByName', 'decidedAt', 'updatedAt']))
           // Onaylanmış etkinlik izin dilekçesiyle onay
        || (e().status == 'proposed' && ne().status == 'approved'
             && (isEventOwner(e()) || eventManager(e().unitId))
             && approvedPetitionFor(ne().petitionId, e().unitId)
             && onlyKeys(['status', 'petitionId', 'petitionNo', 'decisionNote', 'decidedBy', 'decidedByName', 'decidedAt', 'updatedAt']))
           // Etkinlik raporunun onayı
        || (hasPerm('events.manageAll') && ne().status == e().status
             && onlyKeys(['reportApproved', 'reportApprovedBy', 'reportApprovedAt', 'updatedAt']))
           // Yürütme: sorumlular ve birim yöneticileri
        || ((isEventOwner(e()) || eventManager(e().unitId))
             && ne().unitId == e().unitId
             && ne().code == e().code
             && ne().get('reportApproved', false) == e().get('reportApproved', false)
             && (ne().status == e().status
                 || (e().status in ['approved', 'planning', 'registration_open', 'held', 'closing', 'reported']
                     && ne().status in ['planning', 'registration_open', 'held', 'closing', 'reported', 'archived', 'cancelled'])))
      );

      allow delete: if isActive() && eventManager(resource.data.unitId) && resource.data.status in ['proposed', 'rejected'];

      function parentEvent() {
        return get(/databases/$(database)/documents/events/$(id)).data;
      }

      function canHandleParticipants() {
        return isActive() && (isEventOwner(parentEvent()) || eventManager(parentEvent().unitId));
      }

      function participantMayEnter(pid) {
        let path = docPath('eventRestrictionIndex', pid);
        return !exists(path)
          || get(path).data.level != 'blocked'
          || get(path).data.expiresAt <= request.time;
      }

      // Katılımcı listesi kişisel veridir: yalnızca etkinlik sorumluları ve birim yöneticileri.
      match /participants/{pid} {
        allow read, delete: if canHandleParticipants();
        allow create, update: if canHandleParticipants() && participantMayEnter(pid);
      }

      match /syncRuns/{rid} {
        allow read: if canHandleParticipants() || hasPerm('reports.read');
        allow create: if canHandleParticipants() && request.resource.data.by == me();
      }
    }

    match /eventCounters/{year} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.value == 1;
      allow update: if isActive() && request.resource.data.value == resource.data.value + 1;
    }

    // ---------- İletişim talepleri (WP-07) ----------

    match /contentRequests/{id} {
      function c() { return resource.data; }
      function nc() { return request.resource.data; }

      // Etkinlik tanıtımı, etkinlik onaylanmadan yayın takvimine alınamaz.
      function promoOk() {
        return nc().get('eventId', null) == null
          || !(nc().status in ['scheduled', 'published'])
          || get(docPath('events', nc().eventId)).data.status in ['approved', 'planning', 'registration_open', 'held', 'closing', 'reported', 'archived'];
      }

      function requesterUnitApprover() {
        return c().requestingUnitId == 'branch' ? hasPerm('content.manage') : unitManager(c().requestingUnitId);
      }

      allow read: if isActive();

      allow create: if isActive()
        && nc().requestedBy == me()
        && nc().status == 'requested'
        && (hasUnitPerm(nc().requestingUnitId, 'unit.events.propose')
            || unitManager(nc().requestingUnitId)
            || hasPerm('content.manage'));

      allow update: if isActive() && promoOk() && (
           // İletişim birimi: kabul, üretim, onaya sunma, yayın; talep eden birimin onayını atlayamaz
           (hasPerm('content.manage') && nc().requestingUnitId == c().requestingUnitId
             && !(c().status == 'awaiting_approval' && nc().status == 'scheduled' && c().requestingUnitId != 'branch'))
           // Talep eden birimin onayı
        || (c().status == 'awaiting_approval' && nc().status in ['scheduled', 'in_production']
             && requesterUnitApprover()
             && onlyKeys(['status', 'approvedBy', 'approvedByName', 'approvedAt', 'approvalNote', 'updatedAt']))
           // Talep sahibi: kabul edilmeden önce düzenleme veya iptal
        || (c().requestedBy == me() && c().status == 'requested' && nc().status in ['requested', 'cancelled']
             && onlyKeys(['type', 'channels', 'desiredPublishDate', 'brief', 'assets', 'eventId', 'eventName', 'status', 'updatedAt']))
      );

      allow delete: if isActive() && c().requestedBy == me() && c().status == 'requested';
    }

    // ---------- Sponsorluk ve finans (WP-08) ----------

    function sponsorReader(d) {
      return hasPerm('sponsors.read') || hasPerm('sponsors.manage') || (isActive() && d.ownerUid == me());
    }

    match /sponsors/{id} {
      allow read: if sponsorReader(resource.data);
      allow create, delete: if hasPerm('sponsors.manage');
      allow update: if hasPerm('sponsors.manage')
        || (isActive() && resource.data.ownerUid == me() && request.resource.data.ownerUid == me());

      function parentSponsor() {
        return get(/databases/$(database)/documents/sponsors/$(id)).data;
      }

      match /interactions/{iid} {
        allow read: if sponsorReader(parentSponsor());
        allow create: if (hasPerm('sponsors.manage') || (isActive() && parentSponsor().ownerUid == me()))
          && request.resource.data.byUid == me();
        allow update, delete: if hasPerm('sponsors.manage');
      }

      // İletişim kişileri: yalnızca sponsor sorumlusu ve sponsorluk yöneticileri (sponsor kilidi).
      match /private/{docId} {
        allow read, write: if hasPerm('sponsors.manage') || (isActive() && parentSponsor().ownerUid == me());
      }
    }

    // Firma adı → sorumlu. Üyeler yalnızca tek kayıt sorgulayabilir ("bu firmayla görüşen var mı?").
    match /sponsorLocks/{key} {
      allow get: if isActive();
      allow list: if hasPerm('sponsors.read') || hasPerm('sponsors.manage');
      allow write: if hasPerm('sponsors.manage');
    }

    match /sponsorContactRequests/{id} {
      allow read: if isActive()
        && (resource.data.byUid == me() || resource.data.ownerUid == me() || hasPerm('sponsors.manage'));
      allow create: if isActive()
        && request.resource.data.byUid == me()
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow update: if isActive()
        && (resource.data.ownerUid == me() || hasPerm('sponsors.manage'))
        && onlyKeys(['status', 'response', 'respondedAt', 'respondedBy']);
    }

    match /budgets/{id} {
      allow read: if hasPerm('finance.read') || hasPerm('finance.manage')
        || (isActive() && unitManager(resource.data.unitId));
      allow write: if hasPerm('finance.manage');
    }

    // ---------- Sekreterlik defteri ----------

    match /secretaryLedger/{id} {
      function validLedger(d) {
        return d.kind in ['meeting', 'board_decision', 'unit_decision', 'incoming', 'outgoing', 'follow_up', 'note']
          && d.date is string && d.date.size() > 0
          && d.title is string && d.title.size() > 0
          && d.unitId is string && d.unitId.size() > 0
          && d.summary is string;
      }

      allow read: if hasPerm('secretary.ledger.manage');
      allow create: if hasPerm('secretary.ledger.manage')
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validLedger(request.resource.data);
      allow update: if hasPerm('secretary.ledger.manage')
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validLedger(request.resource.data);
      allow delete: if hasPerm('secretary.ledger.manage');
    }

    // ---------- Birim toplantıları ve tutanakları ----------

    match /meetings/{id} {
      function validMeeting(d) {
        return d.unitId is string && d.unitId.size() > 0
          && d.unitName is string
          && d.title is string && d.title.size() > 0
          && d.date is string && d.date.size() > 0
          && d.status in ['draft', 'final']
          && d.attendeeUids is list
          && d.attendeeNames is list
          && d.agenda is list
          && d.decisions is list;
      }

      // Kurul toplantıları (YK / İK / ortak) kurul üyelerinin listesini visibleUids'de taşır.
      allow read: if isActive()
        && (isMember(resource.data.unitId)
            || meetingManager(resource.data.unitId)
            || me() in resource.data.get('visibleUids', []));
      allow create: if meetingManager(request.resource.data.unitId)
        && request.resource.data.status == 'draft'
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validMeeting(request.resource.data);
      allow update: if meetingManager(resource.data.unitId)
        && resource.data.status == 'draft'
        && request.resource.data.unitId == resource.data.unitId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ['draft', 'final']
        && validMeeting(request.resource.data)
        && (request.resource.data.status == 'draft'
            || (request.resource.data.finalizedBy == me()
                && request.resource.data.finalizedAt == request.time));
      allow delete: if meetingManager(resource.data.unitId) && resource.data.status == 'draft';
    }

    // ---------- Kurullar: oylama ve karar defteri (ADR-0034) ----------
    // Oylamayı Genel Sekreter (secretary.ledger.manage) veya organizasyon yöneticisi açar/kapatır.
    // Oy hakkı, oylama açılırken görevdeki atamalardan çıkarılan listeye (roster) dayanır; oy veren
    // kişinin listedeki rolü oy anında da geçerli olmalıdır. Sayım istemcide oy pusulalarından yapılır.

    function boardAdmin() {
      return hasPerm('secretary.ledger.manage') || hasPerm('org.manage');
    }

    function validBoardVote(d) {
      return d.keys().hasOnly([
          'title', 'description', 'scope', 'rule', 'isDecree', 'status', 'closesAt', 'roster',
          'recusedUids', 'fullSizes', 'chairUid', 'meetingId', 'visibleUids',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.description is string && d.description.size() <= 5000
        && d.scope in ['yk', 'ik', 'joint', 'both']
        && d.rule in ['majority', 'absolute', 'twoThirds', 'unanimous']
        && d.isDecree is bool
        // YKK yalnız YK'nın üçte iki oyuyla çıkar (Md. 40-EK.a).
        && (d.isDecree == false || (d.scope == 'yk' && d.rule == 'twoThirds'))
        && d.closesAt is timestamp
        && d.roster is map && d.roster.size() > 0 && d.roster.size() <= 200
        && d.recusedUids is list && d.recusedUids.size() <= 20
        && d.fullSizes is map
        && d.visibleUids is list
        && d.visibleUids.hasAll(d.roster.keys());
    }

    match /boardVotes/{id} {
      allow read: if isActive() && (me() in resource.data.visibleUids || boardAdmin());
      allow create: if boardAdmin()
        && validBoardVote(request.resource.data)
        && request.resource.data.status == 'open'
        && request.resource.data.closesAt > request.time
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Oylama içeriği ve oy hakkı listesi değişmez; yalnız kapatma/iptal ve karar defterine bağlama.
      allow update: if boardAdmin()
        && request.resource.data.updatedAt == request.time
        && ((resource.data.status == 'open'
              && request.resource.data.status in ['closed', 'cancelled']
              && request.resource.data.closedAt == request.time
              && request.resource.data.closedByName is string
              && onlyKeys(['status', 'closedAt', 'closedByName', 'result', 'updatedAt']))
            || (resource.data.status == 'closed'
              && request.resource.data.status == 'closed'
              && !('decisionId' in resource.data)
              && request.resource.data.decisionId is string
              && onlyKeys(['decisionId', 'updatedAt'])
              && getAfter(docPath('boardDecisions', request.resource.data.decisionId)).data.source.id == id));
      allow delete: if false;

      match /ballots/{uid} {
        function parentVote() {
          return get(docPath('boardVotes', id)).data;
        }
        allow read: if isActive() && (me() in parentVote().visibleUids || boardAdmin());
        allow create, update: if isActive()
          && uid == me()
          && parentVote().status == 'open'
          && request.time < parentVote().closesAt
          && me() in parentVote().roster
          && !(me() in parentVote().recusedUids)
          && parentVote().roster[me()].roleKey in acc().get('roleKeys', {})
          && acc().roleKeys[parentVote().roster[me()].roleKey] > request.time
          && request.resource.data.keys().hasOnly(['choice', 'name', 'at'])
          && request.resource.data.choice in ['yes', 'no', 'abstain']
          && request.resource.data.name is string && request.resource.data.name.size() <= 150
          && request.resource.data.at == request.time;
        allow delete: if false;
      }
    }

    // Karar defteri: numaralı, yalnız eklenir. Numara sayaçla aynı batch'te +1 ilerler (boşluksuz).
    function validBoardDecision(d) {
      return d.keys().hasOnly([
          'board', 'year', 'seq', 'number', 'counterId', 'kind', 'date', 'title', 'text', 'result',
          'source', 'correctsId', 'visibility', 'visibleUids', 'createdBy', 'createdByName', 'createdAt'
        ])
        && d.board in ['yk', 'ik', 'joint']
        && d.year is int && d.seq is int && d.seq > 0
        && d.counterId == d.board + '_' + string(d.year)
        && d.number is string && d.number.size() > 0
        && d.kind in ['decision', 'decree']
        && d.date is string && d.date.size() == 10
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.text is string && d.text.size() > 0 && d.text.size() <= 10000
        && d.result is string && d.result.size() <= 2000
        && d.source is map && d.source.type in ['vote', 'meeting', 'manual']
        && d.visibility in ['members', 'board']
        && d.visibleUids is list;
    }

    match /boardDecisions/{id} {
      allow read: if isActive()
        && (resource.data.visibility == 'members' || me() in resource.data.visibleUids || boardAdmin());
      allow create: if boardAdmin()
        && validBoardDecision(request.resource.data)
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && getAfter(docPath('decisionCounters', request.resource.data.counterId)).data.value == request.resource.data.seq
        && getAfter(docPath('decisionCounters', request.resource.data.counterId)).data.lastDecisionId == id
        // Oylamadan gelen karar: oylama kapalı olmalı ve aynı batch'te bu karara bağlanmalı.
        && (request.resource.data.source.type != 'vote'
            || (get(docPath('boardVotes', request.resource.data.source.id)).data.status == 'closed'
                && getAfter(docPath('boardVotes', request.resource.data.source.id)).data.decisionId == id))
        // Kararname (YKK) yalnız kabul edilmiş YKK oylamasından işlenir.
        && (request.resource.data.kind == 'decision'
            || (request.resource.data.source.type == 'vote'
                && get(docPath('boardVotes', request.resource.data.source.id)).data.isDecree == true
                && get(docPath('boardVotes', request.resource.data.source.id)).data.result.outcome == 'accepted'));
      allow update, delete: if false;
    }

    match /decisionCounters/{cid} {
      function pairedDecision() {
        let did = request.resource.data.lastDecisionId;
        return !exists(docPath('boardDecisions', did))
          && getAfter(docPath('boardDecisions', did)).data.counterId == cid
          && getAfter(docPath('boardDecisions', did)).data.seq == request.resource.data.value;
      }
      allow read: if isActive();
      allow create: if boardAdmin() && request.resource.data.value == 1 && pairedDecision();
      allow update: if boardAdmin() && request.resource.data.value == resource.data.value + 1 && pairedDecision();
      allow delete: if false;
    }

    // Bağlantı ayarı gizli anahtar içermez; yine de yalnızca yetkili TechOps görevlileri görür/değiştirir.
    match /externalIntegrations/{id} {
      allow read: if hasPerm('external.firebase.manage');
      allow create, update: if hasPerm('external.firebase.manage')
        && request.resource.data.updatedBy == me()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.apiKey is string
        && request.resource.data.authDomain is string
        && request.resource.data.projectId is string
        && request.resource.data.appId is string
        && request.resource.data.resources is list;
      allow delete: if hasPerm('external.firebase.manage');
    }

    // ---------- Fiziksel demirbaş, zimmet ve değiştirilemez hareket geçmişi ----------

    match /assets/{id} {
      allow read: if assetReader();
      allow create: if assetManager()
        && validAsset(request.resource.data)
        && matchingAssetMovement(id, request.resource.data)
        && request.resource.data.createdBy == me()
        && request.resource.data.updatedBy == me()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if assetManager()
        && validAsset(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastMovementId != resource.data.lastMovementId
        && matchingAssetMovement(id, request.resource.data)
        && request.resource.data.updatedBy == me()
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /assetMovements/{id} {
      allow read: if assetReader();
      allow create: if assetManager()
        && request.resource.data.keys().hasOnly([
          'assetId', 'assetCode', 'assetName', 'type', 'note', 'from', 'to', 'byUid', 'byName', 'at'
        ])
        && request.resource.data.assetId is string
        && request.resource.data.assetCode is string
        && request.resource.data.assetName is string
        && request.resource.data.type in ['create', 'update', 'assign', 'return', 'move', 'maintenance', 'lost', 'retire']
        && request.resource.data.note is string
        && request.resource.data.byUid == me()
        && request.resource.data.byName is string
        && request.resource.data.at == request.time
        && request.resource.data.to is map;
      allow update, delete: if false;
    }

    // ---------- Oda rezervasyonu (ADR-0038) ----------
    // Çakışma belge kimliğiyle önlenir: her yarım saatlik dilim tek bir belgedir
    // (roomSlots/{oda}_{tarih}_{dilim}). Dolu dilim yeniden oluşturulamaz ve güncellenemez;
    // bir rezervasyonun dilimleri tek batch'te yazıldığı için biri doluysa hiçbiri yazılmaz.
    // Tarih ve dilimler oda saatidir (Türkiye, UTC+3 sabit).

    function roomSlotDay(d) {
      return timestamp.date(int(d.date[0:4]), int(d.date[5:7]), int(d.date[8:10]));
    }

    // Dilim henüz bitmedi mi?
    function roomSlotNotEnded(d) {
      return roomSlotDay(d) + duration.value(d.slot * 30 + 30, 'm') > request.time + duration.value(3, 'h');
    }

    match /rooms/{id} {
      function validRoom(d) {
        return d.keys().hasOnly(['name', 'location', 'note', 'openSlot', 'closeSlot', 'maxDaysAhead', 'active', 'createdAt', 'updatedAt', 'updatedBy'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.location is string && d.location.size() <= 160
          && d.note is string && d.note.size() <= 500
          && d.openSlot is int && d.closeSlot is int
          && d.openSlot >= 0 && d.closeSlot <= 48 && d.openSlot < d.closeSlot
          && d.maxDaysAhead is int && d.maxDaysAhead >= 1 && d.maxDaysAhead <= 365
          && d.active is bool
          && d.updatedAt == request.time
          && d.updatedBy == me();
      }

      allow read: if isActive();
      allow create: if hasPerm('org.manage')
        && validRoom(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if hasPerm('org.manage')
        && validRoom(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      // Oda silinmez, pasife alınır; geçmiş rezervasyonlar sahipsiz kalmaz.
      allow delete: if false;
    }

    match /roomSlots/{id} {
      function s() { return request.resource.data; }
      function room() { return get(docPath('rooms', s().roomId)).data; }

      allow read: if isActive();
      // Yalnızca ilgili birimde 'unit.room.reserve' izni olan (varsayılan: komite başkanı) rezervasyon yapar.
      allow create: if hasUnitPerm(s().unitId, 'unit.room.reserve')
        && s().keys().hasOnly(['roomId', 'date', 'slot', 'groupId', 'unitId', 'unitName', 'kind', 'title', 'note', 'byUid', 'byName', 'createdAt'])
        && s().roomId is string && s().roomId.size() > 0
        && s().date is string && s().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && s().slot is int && s().slot >= 0 && s().slot < 48
        && id == s().roomId + '_' + s().date + '_' + (s().slot < 10 ? '0' : '') + string(s().slot)
        && room().active == true
        && s().slot >= room().openSlot && s().slot < room().closeSlot
        && roomSlotNotEnded(s())
        && roomSlotDay(s()) < request.time + duration.value(room().maxDaysAhead, 'd')
        && s().groupId is string && s().groupId.size() > 0 && s().groupId.size() <= 40
        && s().unitId is string && s().unitName is string && s().unitName.size() <= 160
        && s().kind in ['interview', 'meeting', 'event', 'other']
        && s().title is string && s().title.size() > 0 && s().title.size() <= 120
        && s().note is string && s().note.size() <= 500
        && s().byUid == me()
        && s().byName is string && s().byName.size() <= 160
        && s().createdAt == request.time;
      allow update: if false;
      // İptal = dilimi boşaltmak. Bitmiş dilimler kullanım geçmişi olarak kalır; yalnız organizasyon yöneticisi siler.
      allow delete: if hasPerm('org.manage')
        || (isActive()
            && roomSlotNotEnded(resource.data)
            && (resource.data.byUid == me() || hasUnitPerm(resource.data.unitId, 'unit.room.reserve')));
    }

    // ---------- Raporlar (WP-09) ----------

    match /reports/{id} {
      allow read: if hasPerm('reports.read') || hasPerm('reports.approve');
      allow create: if (hasPerm('reports.read') || hasPerm('reports.approve'))
        && request.resource.data.generatedBy == me()
        && request.resource.data.status == 'draft'
        && request.resource.data.generatedAt == request.time;
      allow update: if hasPerm('reports.approve')
        && resource.data.status == 'draft'
        && request.resource.data.status == 'approved'
        && request.resource.data.approvedBy == me()
        && onlyKeys(['status', 'approvedBy', 'approvedByName', 'approvedAt']);
      allow delete: if hasPerm('reports.approve') && resource.data.status == 'draft';
    }

    // ---------- Envanter (WP-01) ----------

    match /inventory/{id} {
      allow read, write: if hasPerm('inventory.manage');
    }

    // ---------- Devir paketleri (WP-10) ----------

    match /handovers/{id} {
      allow read: if isActive()
        && (resource.data.authorUid == me()
            || hasPerm('handover.manage')
            || resource.data.visibleTo.hasAny(myTokens()));
      allow create: if isActive()
        && request.resource.data.authorUid == me()
        && request.resource.data.status == 'draft'
        && (hasRoleKey(request.resource.data.unitId + '__' + request.resource.data.roleId) || hasPerm('handover.manage'));
      allow update: if isActive() && (
           (resource.data.authorUid == me() && resource.data.status != 'accepted'
             && request.resource.data.authorUid == me()
             && request.resource.data.status in ['draft', 'submitted'])
        || (hasPerm('handover.manage') && resource.data.status == 'submitted'
             && request.resource.data.status in ['accepted', 'draft']
             && onlyKeys(['status', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'reviewNote', 'updatedAt']))
      );
      allow delete: if isActive() && resource.data.authorUid == me() && resource.data.status == 'draft';
    }

    // ---------- Destek (WP-10) ----------

    match /feedback/{id} {
      allow read: if isActive() && (resource.data.byUid == me() || hasPerm('inventory.manage'));
      allow create: if isActive()
        && request.resource.data.byUid == me()
        && request.resource.data.status == 'open'
        && request.resource.data.at == request.time;
      allow update: if hasPerm('inventory.manage') && onlyKeys(['status', 'response', 'respondedBy', 'respondedAt']);
    }
  }
}
